{
  "name": "Tof",
  "short_name": "Tof",
  "description": "Stats and a reader for TextNow conversation exports.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f5f6",
  "theme_color": "#0f7c86",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        { "name": "exports", "accept": ["text/html", "text/plain", ".html", ".htm", ".txt"] }
      ]
    }
  }
}
